@model HiddenMK.Models.Story
@{ var key=$"story.{Model.Id}"; ViewData["Title"] = Localizer.Get($"{key}.title"); }
<section class="story-detail-hero" style="background-image:linear-gradient(rgba(10,18,14,.25),rgba(10,18,14,.75)),url('@Model.ImageUrl');"><div class="container"><div class="story-detail-heading"><div class="section-label section-label-light">@Localizer.Get($"{key}.category")</div><h1>@Localizer.Get($"{key}.title")</h1><div class="story-detail-meta"><span>@Localizer.Get($"{key}.date")</span><span>·</span><span>@Model.ReadingTime @Localizer.Get("common.minread")</span><span>·</span><span>@Localizer.Get($"{key}.author")</span></div></div></div></section>
<section class="hidden-section story-content-section"><div class="container"><div class="row justify-content-center"><div class="col-lg-8"><div class="story-introduction">@Localizer.Get($"{key}.excerpt")</div><div class="story-content">@foreach(var paragraph in Localizer.Get($"{key}.content").Split("\n\n")){<p>@paragraph</p>}</div><div class="story-share"><span>@Localizer.Get("stories.share")</span><div><a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a><a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a><a href="#" aria-label="Copy link"><i class="bi bi-link-45deg"></i></a></div></div></div></div></div></section>
<section class="destination-cta"><div class="container"><div class="destination-cta-content"><div><div class="section-label section-label-light">@Localizer.Get("stories.keepExploring")</div><h2>@Html.Raw(Localizer.Get("stories.cta"))</h2></div><a asp-controller="Destinations" asp-action="Index" class="hidden-btn hidden-btn-primary">@Localizer.Get("common.exploredestinations") <i class="bi bi-arrow-right"></i></a></div></div></section>