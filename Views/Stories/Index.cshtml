@model IEnumerable<HiddenMK.Models.Story>
@{ ViewData["Title"] = Localizer.Get("stories.title"); }
<section class="page-hero stories-hero"><div class="container"><div class="section-label section-label-light">@Localizer.Get("stories.heroLabel")</div><h1>@Html.Raw(Localizer.Get("stories.heroTitle"))</h1><p>@Localizer.Get("stories.heroText")</p></div></section>
<section class="hidden-section"><div class="container"><div class="stories-page-header"><div><div class="section-label">@Localizer.Get("stories.label")</div><h2 class="section-title">@Html.Raw(Localizer.Get("stories.heading"))</h2></div><p class="section-description">@Localizer.Get("stories.intro")</p></div><div class="row g-5">@foreach(var story in Model){var key=$"story.{story.Id}";<div class="col-lg-6"><article class="blog-card"><a asp-controller="Stories" asp-action="Details" asp-route-id="@story.Id"><div class="blog-card-image"><img src="@story.ImageUrl" alt="@Localizer.Get($"{key}.title")" /></div></a><div class="blog-card-content"><div class="blog-card-meta"><span>@Localizer.Get($"{key}.category")</span><span>@story.ReadingTime @Localizer.Get("common.minread")</span></div><h3><a asp-controller="Stories" asp-action="Details" asp-route-id="@story.Id">@Localizer.Get($"{key}.title")</a></h3><p>@Localizer.Get($"{key}.excerpt")</p><div class="blog-card-footer"><span>@Localizer.Get($"{key}.date")</span><a asp-controller="Stories" asp-action="Details" asp-route-id="@story.Id">@Localizer.Get("stories.read") <i class="bi bi-arrow-up-right"></i></a></div></div></article></div>}</div></div></section>