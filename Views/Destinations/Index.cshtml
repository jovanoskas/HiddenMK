@model IEnumerable<HiddenMK.Models.Destination>
@{ ViewData["Title"] = Localizer.Get("destinations.title"); }
<section class="page-hero destinations-hero"><div class="container"><div class="section-label section-label-light">@Localizer.Get("destinations.heroLabel")</div><h1>@Html.Raw(Localizer.Get("destinations.heroTitle"))</h1><p>@Localizer.Get("destinations.heroText")</p></div></section>
<section class="hidden-section destinations-page"><div class="container"><div class="destinations-intro"><div><div class="section-label">@Localizer.Get("destinations.label")</div><h2 class="section-title">@Html.Raw(Localizer.Get("destinations.heading"))</h2></div><p class="section-description">@Localizer.Get("destinations.intro")</p></div><div class="row g-4">@foreach(var destination in Model){<div class="col-lg-6"><a asp-controller="Destinations" asp-action="Details" asp-route-id="@destination.Id" class="destination-list-card"><div class="destination-list-image"><img src="@destination.ImageUrl" alt="@Localizer.Get($"destination.{destination.Id}.name")" /></div><div class="destination-list-content"><div class="destination-list-meta"><span>@Localizer.Get($"destination.{destination.Id}.category")</span><span>@Localizer.Get($"destination.{destination.Id}.region")</span></div><h3>@Localizer.Get($"destination.{destination.Id}.name")</h3><p>@Localizer.Get($"destination.{destination.Id}.short")</p><span class="destination-arrow">@Localizer.Get("common.explore") <i class="bi bi-arrow-up-right"></i></span></div></a></div>}</div></div></section>