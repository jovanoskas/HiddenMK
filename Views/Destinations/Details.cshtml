@model HiddenMK.Models.Destination
@{ var key=$"destination.{Model.Id}"; ViewData["Title"] = Localizer.Get($"{key}.name"); }
<section class="destination-detail-hero" style="background-image:linear-gradient(rgba(10,18,14,.25),rgba(10,18,14,.75)),url('@Model.ImageUrl');"><div class="container"><div class="destination-detail-heading"><div class="section-label section-label-light">@Localizer.Get($"{key}.category")</div><h1>@Localizer.Get($"{key}.name")</h1><p>@Localizer.Get($"{key}.short")</p></div></div></section>
<section class="hidden-section"><div class="container"><div class="row g-5"><div class="col-lg-8"><div class="section-label">@Localizer.Get("destinations.overview")</div><h2 class="section-title">@Localizer.Get($"{key}.name")</h2><p class="section-text">@Localizer.Get($"{key}.description")</p><h3 class="h4 mt-4">@Localizer.Get("destinations.gettingThere")</h3><p class="section-text">@Localizer.Get($"{key}.road")</p></div><div class="col-lg-4"><div class="destination-info-card"><div><span>@Localizer.Get("destinations.difficulty")</span><strong>@Localizer.Get($"{key}.difficulty")</strong></div><div><span>@Localizer.Get("destinations.duration")</span><strong>@Localizer.Get($"{key}.duration")</strong></div><div><span>@Localizer.Get("destinations.bestSeason")</span><strong>@Localizer.Get($"{key}.season")</strong></div></div></div></div><div class="mt-5"><div class="section-label">@Localizer.Get("destinations.activities")</div><div class="row g-3">@for(int i=1;i<=4;i++){<div class="col-md-6"><div class="value-card"><i class="bi bi-check2-circle"></i><span>@Localizer.Get($"{key}.a{i}")</span></div></div>}</div></div><a asp-controller="Destinations" asp-action="Index" class="hidden-btn hidden-btn-dark mt-5">@Localizer.Get("destinations.back") <i class="bi bi-arrow-left"></i></a></div></section>