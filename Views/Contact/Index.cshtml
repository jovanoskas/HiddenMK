@model HiddenMK.Models.ContactMessage
@{
    ViewData["Title"] = Localizer.Get("contact.title");
}

<section class="page-hero">
    <div class="container">
        <span class="hero-eyebrow">@Localizer.Get("contact.eyebrow")</span>
        <h1>@Localizer.Get("contact.hero")</h1>
        <p>@Localizer.Get("contact.heroText")</p>
    </div>
</section>

<section class="hidden-section">
    <div class="container">
        @if (TempData["ContactSuccess"] != null)
        {
            <div class="contact-success mb-5">
                <i class="bi bi-check-circle"></i>
                <div>
                    <strong>@Localizer.Get("contact.successTitle")</strong>
                    <p>@Localizer.Get("contact.success")</p>
                </div>
            </div>
        }

        <div class="row g-5">
            <div class="col-lg-5">
                <span class="section-eyebrow">@Localizer.Get("contact.label")</span>
                <h2 class="section-title">@Localizer.Get("contact.heading")</h2>
                <p class="section-text">@Localizer.Get("contact.text")</p>

                <div class="contact-details">
                    <div class="contact-detail">
                        <div class="contact-icon"><i class="bi bi-envelope"></i></div>
                        <div>
                            <span>@Localizer.Get("contact.email")</span>
                            <a href="mailto:hello@hiddenmk.com">hello@hiddenmk.com</a>
                        </div>
                    </div>
                    <div class="contact-detail">
                        <div class="contact-icon"><i class="bi bi-telephone"></i></div>
                        <div>
                            <span>@Localizer.Get("contact.phone")</span>
                            <a href="tel:+38978221640">@Localizer.Get("contact.phoneNumber")</a>
                        </div>
                    </div>
                    <div class="contact-detail">
                        <div class="contact-icon"><i class="bi bi-geo-alt"></i></div>
                        <div>
                            <span>@Localizer.Get("contact.based")</span>
                            <strong>@Localizer.Get("contact.location")</strong>
                        </div>
                    </div>
                    <div class="contact-detail">
                        <div class="contact-icon"><i class="bi bi-clock"></i></div>
                        <div>
                            <span>@Localizer.Get("contact.available")</span>
                            <strong>@Localizer.Get("contact.hours")</strong>
                        </div>
                    </div>
                </div>

                <div class="contact-social">
                    <span>@Localizer.Get("contact.follow")</span>
                    <div>
                        <a href="https://www.instagram.com/hiddenmk.skopje" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.facebook.com/hiddenmk.skopje" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="https://www.youtube.com/@@hiddenmkskopje" target="_blank" rel="noopener" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="contact-form-card">
                    <div class="mb-4">
                        <span class="section-eyebrow">@Localizer.Get("contact.send")</span>
                        <h3>@Localizer.Get("contact.formHeading")</h3>
                    </div>

                    <form asp-controller="Contact" asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">@Localizer.Get("contact.name")</label>
                                <input asp-for="Name" class="form-control hidden-input" placeholder="@Localizer.Get("contact.name")" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">@Localizer.Get("contact.email")</label>
                                <input asp-for="Email" class="form-control hidden-input" placeholder="@Localizer.Get("contact.emailPlaceholder")" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Subject" class="form-label">@Localizer.Get("contact.subject")</label>
                                <input asp-for="Subject" class="form-control hidden-input" placeholder="@Localizer.Get("contact.subjectPlaceholder")" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label">@Localizer.Get("contact.message")</label>
                                <textarea asp-for="Message" class="form-control hidden-input" rows="6" placeholder="@Localizer.Get("contact.messagePlaceholder")"></textarea>
                                <span asp-validation-for="Message" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="hidden-btn hidden-btn-dark">
                                    @Localizer.Get("contact.sendButton")
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="contact-location">
    <iframe class="contact-map"
            title="@Localizer.Get("contact.location")"
            loading="lazy"
            src="https://www.openstreetmap.org/export/embed.html?bbox=21.405%2C41.990%2C21.435%2C42.008&amp;layer=mapnik&amp;marker=41.9985%2C21.4190"></iframe>
    <p class="contact-map-note">
        @Localizer.Get("contact.location") — @Localizer.Get("contact.locationText")
        <a href="https://www.openstreetmap.org/?mlat=41.9985&amp;mlon=21.4190#map=16/41.9985/21.4190" target="_blank" rel="noopener">OpenStreetMap</a>
    </p>
</section>
