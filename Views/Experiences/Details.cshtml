@model HiddenMK.Models.Experience
@{ var key=$"experience.{Model.Id}"; ViewData["Title"] = Localizer.Get($"{key}.name"); }
<section class="story-detail-hero" style="background-image:linear-gradient(rgba(10,18,14,.25),rgba(10,18,14,.75)),url('@Model.ImageUrl');"><div class="container"><div class="story-detail-heading"><div class="section-label section-label-light">@Localizer.Get($"{key}.category")</div><h1>@Localizer.Get($"{key}.name")</h1><div class="story-detail-meta"><span>@Localizer.Get($"{key}.location")</span><span>·</span><span>@Localizer.Get($"{key}.duration")</span><span>·</span><span>@Localizer.Get($"{key}.season")</span></div></div></div></section>
<section class="hidden-section story-content-section"><div class="container"><div class="row justify-content-center"><div class="col-lg-8"><div class="story-introduction">@Localizer.Get($"{key}.description")</div><div class="destination-info-card mt-5"><div><span>@Localizer.Get("experiences.location")</span><strong>@Localizer.Get($"{key}.location")</strong></div><div><span>@Localizer.Get("experiences.duration")</span><strong>@Localizer.Get($"{key}.duration")</strong></div><div><span>@Localizer.Get("experiences.difficulty")</span><strong>@Localizer.Get($"{key}.difficulty")</strong></div><div><span>@Localizer.Get("experiences.season")</span><strong>@Localizer.Get($"{key}.season")</strong></div></div><a asp-controller="Experiences" asp-action="Index" class="hidden-btn hidden-btn-dark mt-5">@Localizer.Get("experiences.back") <i class="bi bi-arrow-left"></i></a></div></div></div></section>