@{ ViewData["Title"] = Localizer.Get("nav.discover"); }
<section class="page-hero discover-hero"><div class="container"><span class="hero-eyebrow">@Localizer.Get("discover.eyebrow")</span><h1>@Localizer.Get("discover.title")<br />@Localizer.Get("discover.subtitle")</h1><p>@Localizer.Get("destinations.heroText")</p></div></section>
<section class="hidden-section"><div class="container"><div class="row justify-content-center text-center"><div class="col-lg-8"><span class="section-eyebrow">@Localizer.Get("discover.beyond")</span><h2 class="section-title">@Localizer.Get("discover.looking")</h2><p class="section-text mx-auto">@Localizer.Get("discover.lookingText")</p></div></div></div></section>
<section class="hidden-section hidden-section-light"><div class="container"><div class="row g-4"><div class="col-md-6 col-lg-3"><a asp-controller="Destinations" asp-action="Index" class="discover-category"><div class="discover-category-icon"><i class="bi bi-tree"></i></div><span>01</span><h3>@Localizer.Get("discover.nature")</h3><p>@Localizer.Get("discover.natureText")</p><strong>@Localizer.Get("discover.exploreNature") <i class="bi bi-arrow-right"></i></strong></a></div><div class="col-md-6 col-lg-3"><a asp-controller="Stories" asp-action="Index" class="discover-category"><div class="discover-category-icon"><i class="bi bi-bank"></i></div><span>02</span><h3>@Localizer.Get("discover.culture")</h3><p>@Localizer.Get("discover.cultureText")</p><strong>@Localizer.Get("discover.discoverCulture") <i class="bi bi-arrow-right"></i></strong></a></div><div class="col-md-6 col-lg-3"><a asp-controller="Stories" asp-action="Index" class="discover-category"><div class="discover-category-icon"><i class="bi bi-cup-hot"></i></div><span>03</span><h3>@Localizer.Get("discover.food")</h3><p>@Localizer.Get("discover.foodText")</p><strong>@Localizer.Get("discover.taste") <i class="bi bi-arrow-right"></i></strong></a></div><div class="col-md-6 col-lg-3"><a asp-controller="Experiences" asp-action="Index" class="discover-category"><div class="discover-category-icon"><i class="bi bi-compass"></i></div><span>04</span><h3>@Localizer.Get("discover.adventure")</h3><p>@Localizer.Get("discover.adventureText")</p><strong>@Localizer.Get("discover.findAdventure") <i class="bi bi-arrow-right"></i></strong></a></div></div></div></section>
<section class="hidden-section"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-5"><span class="section-eyebrow">@Localizer.Get("discover.how")</span><h2 class="section-title">@Localizer.Get("discover.howTitle")</h2><p class="section-text">@Localizer.Get("discover.howText")</p></div><div class="col-lg-7"><div class="discover-steps"><div class="discover-step"><div class="discover-step-number">01</div><div><h3>@Localizer.Get("discover.step1")</h3><p>@Localizer.Get("discover.step1Text")</p></div></div><div class="discover-step"><div class="discover-step-number">02</div><div><h3>@Localizer.Get("discover.step2")</h3><p>@Localizer.Get("discover.step2Text")</p></div></div><div class="discover-step"><div class="discover-step-number">03</div><div><h3>@Localizer.Get("discover.step3")</h3><p>@Localizer.Get("discover.step3Text")</p></div></div></div></div></div></div></section>
<section class="hidden-section hidden-section-dark"><div class="container"><div class="row align-items-end mb-5"><div class="col-lg-8"><span class="section-eyebrow">@Localizer.Get("discover.start")</span><h2 class="section-title">@Localizer.Get("discover.places")</h2></div><div class="col-lg-4 text-lg-end"><a asp-controller="Destinations" asp-action="Index" class="hidden-btn hidden-btn-light">@Localizer.Get("discover.viewAll") <i class="bi bi-arrow-right"></i></a></div></div><div class="row g-4"><div class="col-md-4"><a asp-controller="Destinations" asp-action="Details" asp-route-id="1" class="discover-feature-card"><div class="discover-feature-image discover-feature-galicnik"></div><div class="discover-feature-content"><span>@Localizer.Get("destination.1.region")</span><h3>@Localizer.Get("destination.1.name")</h3><p>@Localizer.Get("destination.1.short")</p></div></a></div><div class="col-md-4"><a asp-controller="Destinations" asp-action="Details" asp-route-id="3" class="discover-feature-card"><div class="discover-feature-image discover-feature-prespa"></div><div class="discover-feature-content"><span>@Localizer.Get("destination.3.region")</span><h3>@Localizer.Get("destination.3.name")</h3><p>@Localizer.Get("destination.3.short")</p></div></a></div><div class="col-md-4"><a asp-controller="Destinations" asp-action="Details" asp-route-id="4" class="discover-feature-card"><div class="discover-feature-image discover-feature-matka"></div><div class="discover-feature-content"><span>@Localizer.Get("destination.4.region")</span><h3>@Localizer.Get("destination.4.name")</h3><p>@Localizer.Get("destination.4.short")</p></div></a></div></div></div></section>
<section class="hidden-section"><div class="container text-center"><span class="section-eyebrow">@Localizer.Get("discover.finalEyebrow")</span><h2 class="section-title">@Localizer.Get("discover.finalTitle")</h2><p class="section-text mx-auto">@Localizer.Get("discover.finalText")</p><a asp-controller="Experiences" asp-action="Index" class="hidden-btn hidden-btn-dark">@Localizer.Get("experiences.findButton") <i class="bi bi-arrow-right"></i></a></div></section>