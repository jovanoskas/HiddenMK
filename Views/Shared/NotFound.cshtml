@{ ViewData["Title"] = Localizer.Get("error.title"); }
<section class="error-page"><div class="container text-center"><span class="error-number">404</span><span class="hero-eyebrow">@Localizer.Get("error.eyebrow")</span><h1>@Localizer.Get("error.heading")</h1><p>@Localizer.Get("error.text")</p><div class="error-actions"><a asp-controller="Home" asp-action="Index" class="hidden-btn hidden-btn-dark">@Localizer.Get("error.home") <i class="bi bi-arrow-right"></i></a><a asp-controller="Destinations" asp-action="Index" class="hidden-btn hidden-btn-outline">@Localizer.Get("common.exploredestinations") <i class="bi bi-compass"></i></a></div></div></section>