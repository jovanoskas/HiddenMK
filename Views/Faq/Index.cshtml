@{ ViewData["Title"] = Localizer.Get("faq.title"); }
<section class="page-hero"><div class="container"><span class="hero-eyebrow">@Localizer.Get("faq.eyebrow")</span><h1>@Localizer.Get("faq.title")</h1><p>@Localizer.Get("faq.heading")</p></div></section>
<section class="hidden-section"><div class="container"><div class="row justify-content-center"><div class="col-lg-9"><div class="accordion hidden-accordion" id="faqAccordion">@for(int i=1;i<=6;i++){<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq@i">@Localizer.Get($"faq.q{i}")</button></h2><div id="faq@i" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">@Localizer.Get($"faq.a{i}")</div></div></div>}</div></div></div></div></section>
<section class="hidden-section hidden-section-light"><div class="container text-center"><span class="section-eyebrow">@Localizer.Get("faq.still")</span><h2 class="section-title">@Localizer.Get("faq.ask")</h2><p class="section-text mx-auto">@Localizer.Get("faq.more")</p><a asp-controller="Contact" asp-action="Index" class="hidden-btn hidden-btn-dark">@Localizer.Get("common.contact") <i class="bi bi-arrow-right"></i></a></div></section>