@{
    ViewData["Title"] = Localizer.Get("team.title");
}

<section class="page-hero">
    <div class="container">
        <span class="hero-eyebrow">@Localizer.Get("team.eyebrow")</span>
        <h1>@Localizer.Get("team.heading")</h1>
        <p>@Localizer.Get("team.intro")</p>
    </div>
</section>

<section class="hidden-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-eyebrow">@Localizer.Get("team.label")</span>
            <h2 class="section-title">@Localizer.Get("team.subtitle")</h2>
        </div>
        <div class="row g-4">
            @for (var i = 1; i <= 4; i++)
            {
                var name = Localizer.Get($"team.name{i}");
                <div class="col-md-6 col-lg-3">
                    <div class="team-card">
                        <div class="team-avatar av-@i">@name.Substring(0, 1)</div>
                        <span class="team-role">@Localizer.Get($"team.role{i}")</span>
                        <h3>@name</h3>
                        <p>@Localizer.Get($"team.bio{i}")</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="hidden-section hidden-section-dark">
    <div class="container text-center">
        <span class="section-eyebrow">@Localizer.Get("team.join")</span>
        <h2 class="section-title">@Localizer.Get("team.joinTitle")</h2>
        <p class="section-text mx-auto">@Localizer.Get("team.joinText")</p>
        <a asp-controller="Contact" asp-action="Index" class="hidden-btn hidden-btn-light">
            @Localizer.Get("team.joinButton") <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</section>
