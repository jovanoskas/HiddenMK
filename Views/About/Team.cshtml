@{ ViewData["Title"] = Localizer.Get("team.title"); }
<section class="page-hero"><div class="container"><span class="hero-eyebrow">@Localizer.Get("team.eyebrow")</span><h1>@Localizer.Get("team.heading")</h1><p>@Localizer.Get("team.intro")</p></div></section>
<section class="hidden-section"><div class="container"><div class="text-center mb-5"><span class="section-eyebrow">@Localizer.Get("team.label")</span><h2 class="section-title">@Localizer.Get("team.subtitle")</h2></div><div class="row g-4"><div class="col-md-6 col-lg-3"><div class="team-card"><div class="team-avatar"><i class="bi bi-person"></i></div><span class="team-role">@Localizer.Get("team.role1")</span><h3>Elena Petrova</h3><p>@Localizer.Get("team.bio1")</p></div></div><div class="col-md-6 col-lg-3"><div class="team-card"><div class="team-avatar"><i class="bi bi-person"></i></div><span class="team-role">@Localizer.Get("team.role2")</span><h3>Marko Iliev</h3><p>@Localizer.Get("team.bio2")</p></div></div><div class="col-md-6 col-lg-3"><div class="team-card"><div class="team-avatar"><i class="bi bi-person"></i></div><span class="team-role">@Localizer.Get("team.role3")</span><h3>Ana Stojanovska</h3><p>@Localizer.Get("team.bio3")</p></div></div><div class="col-md-6 col-lg-3"><div class="team-card"><div class="team-avatar"><i class="bi bi-person"></i></div><span class="team-role">@Localizer.Get("team.role4")</span><h3>David Nikolov</h3><p>@Localizer.Get("team.bio4")</p></div></div></div></div></section>
<section class="hidden-section hidden-section-dark"><div class="container text-center"><span class="section-eyebrow">@Localizer.Get("team.join")</span><h2 class="section-title">@Localizer.Get("team.joinTitle")</h2><p class="section-text mx-auto">@Localizer.Get("team.joinText")</p><a asp-controller="Contact" asp-action="Index" class="hidden-btn hidden-btn-light">@Localizer.Get("team.joinButton") <i class="bi bi-arrow-right"></i></a></div></section>