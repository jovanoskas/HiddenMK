@{ ViewData["Title"] = Localizer.Get("about.title"); }
<section class="page-hero"><div class="container"><span class="hero-eyebrow">@Localizer.Get("about.eyebrow")</span><h1>@Html.Raw(Localizer.Get("about.title"))</h1><p>@Localizer.Get("about.intro")</p></div></section>
<section class="hidden-section"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-6"><span class="section-eyebrow">@Localizer.Get("about.storyEyebrow")</span><h2 class="section-title">@Localizer.Get("about.storyTitle")</h2><p class="section-text">@Localizer.Get("about.story1")</p><p class="section-text">@Localizer.Get("about.story2")</p><p class="section-text">@Localizer.Get("about.story3")</p></div><div class="col-lg-6"><div class="about-highlight"><span>@Localizer.Get("about.philosophy")</span><h3>@Html.Raw(Localizer.Get("about.philosophyText"))</h3></div></div></div></div></section>
<section class="hidden-section hidden-section-light"><div class="container"><div class="text-center mb-5"><span class="section-eyebrow">@Localizer.Get("about.values")</span><h2 class="section-title">@Localizer.Get("about.moreThan")</h2><p class="section-text mx-auto">@Localizer.Get("about.valuesIntro")</p></div><div class="row g-4"><div class="col-md-4"><div class="value-card"><div class="value-icon"><i class="bi bi-compass"></i></div><h3>@Localizer.Get("about.value1Title")</h3><p>@Localizer.Get("about.value1")</p></div></div><div class="col-md-4"><div class="value-card"><div class="value-icon"><i class="bi bi-people"></i></div><h3>@Localizer.Get("about.value2Title")</h3><p>@Localizer.Get("about.value2")</p></div></div><div class="col-md-4"><div class="value-card"><div class="value-icon"><i class="bi bi-tree"></i></div><h3>@Localizer.Get("about.value3Title")</h3><p>@Localizer.Get("about.value3")</p></div></div></div></div></section>
<section class="hidden-section"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-5"><span class="section-eyebrow">@Localizer.Get("about.idea")</span><h2 class="section-title">@Localizer.Get("about.ideaTitle")</h2></div><div class="col-lg-7"><p class="section-text">@Localizer.Get("about.ideaText")</p><a asp-controller="Contact" asp-action="Index" class="hidden-btn hidden-btn-dark">@Localizer.Get("common.contact") <i class="bi bi-arrow-right"></i></a></div></div></div></section>